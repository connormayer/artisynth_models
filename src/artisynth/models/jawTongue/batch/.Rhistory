ggplot(mci_frame, aes(x = semitone_group, y = MCI)) +
geom_boxplot(outlier.shape = 16, outlier.alpha = 0.2, width = 0.5, fill = "lightblue", colour = "black") +
coord_cartesian(ylim = c(0, 10)) +   # <- zoom into the region where most data lives
labs(
title = "MCI by pitch-range half",
x = "Pitch range group",
y = "MCI"
) +
theme_bw()
