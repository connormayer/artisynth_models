dat <- mci_exp %>%
mutate(f0_mean = as.numeric(f0_mean)) %>%  # safe even if already numeric
filter(
!is.na(participant),
!is.na(f0_mean),
f0_mean > 100
)
f0_by_participant_100 <- dat %>%
group_by(participant) %>%
summarise(
n         = n(),
min_f0    = min(f0_mean, na.rm = TRUE),
q05_f0    = quantile(f0_mean, 0.05, na.rm = TRUE),
median_f0 = median(f0_mean, na.rm = TRUE),
q95_f0    = quantile(f0_mean, 0.95, na.rm = TRUE),
max_f0    = max(f0_mean, na.rm = TRUE),
.groups   = "drop"
)
# Look at extremes if you want
f0_by_participant_100 %>% arrange(min_f0)      %>% head(10)
f0_by_participant_100 %>% arrange(desc(max_f0)) %>% head(10)
range_pt <- dat %>%
group_by(participant, skill_level) %>%   # skill_level stays attached
summarise(
q05_f0   = quantile(f0_mean, 0.05, na.rm = TRUE),
q95_f0   = quantile(f0_mean, 0.95, na.rm = TRUE),
range_st = 12 * log2(q95_f0 / q05_f0),  # semitone range
.groups  = "drop"
)
range_pt %>% arrange(desc(range_st)) %>% head()
range_pt %>%
mutate(
skill_level = factor(skill_level, levels = c("1", "2", "3", "4")),
range_tones = range_st / 2          # convert semitones → tones
) %>%
ggplot(aes(x = range_tones, fill = skill_level)) +
geom_histogram(
binwidth = 1,        # 1 tone = 2 semitones
boundary = 0,        # bins like [0–1], [1–2], etc. in tones
position = "stack",
alpha = 0.8,
colour = "black"
) +
scale_fill_brewer(
palette  = "Dark2",
direction = 1,
name = "Experience level"
) +
labs(
title = "Pitch range (tones) by experience level",
x = "Pitch range (tones)",
y = "Number of participants"
) +
theme_bw()
range_pt %>%
mutate(participant = forcats::fct_reorder(participant, range_st)) %>%
ggplot(aes(x = range_st, y = participant, fill = range_st)) +
geom_col() +
scale_x_continuous(expand = c(0, 0)) +
labs(
title = "Whistling pitch range by participant",
x = "Pitch range (semitones)",
y = "Participant"
) +
theme_bw()
range_pt %>%
ggplot(aes(x = range_st)) +
geom_histogram(binwidth = 1, boundary = 0,
colour = "black", fill = "grey70") +
labs(
