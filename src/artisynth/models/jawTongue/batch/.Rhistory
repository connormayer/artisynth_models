library(tidyverse)
# 1. Compute tones from semitones
range_tones_vec <- range_pt$range_st / 2   # numeric vector
# 2. Kernel density estimate, starting at 0 tones
dens_obj <- density(range_tones_vec, from = 0)
dens_df <- tibble(
range_tones = dens_obj$x,
density     = dens_obj$y
)
# 3. 95% central interval for pitch range in tones
q_tones <- quantile(range_tones_vec, probs = c(0.025, 0.975), na.rm = TRUE)
dens_df <- dens_df %>%
mutate(in_CI = range_tones >= q_tones[1] & range_tones <= q_tones[2])
# 4. Plot: curve in tones + CI shading
ggplot(dens_df, aes(x = range_tones, y = density)) +
# shaded 95% CI under the curve
geom_area(
data = ~ filter(.x, in_CI),
alpha = 0.3,
fill  = "lightblue"
) +
# main fitted density curve
geom_line(colour = "blue", size = 1) +
labs(
title = "Pitch range distribution (tones)",
x     = "Pitch range (tones)",
y     = "Density"
) +
coord_cartesian(xlim = c(0, NA)) +  # start tone count at 0
theme_bw()
range_pt %>%
mutate(participant = forcats::fct_reorder(participant, range_st)) %>%
ggplot(aes(x = range_st, y = participant, fill = range_st)) +
geom_col() +
scale_x_continuous(expand = c(0, 0)) +
labs(
title = "Whistling pitch range by participant",
x = "Pitch range (semitones)",
y = "Participant"
) +
theme_bw()
range_pt %>%
ggplot(aes(x = range_st)) +
geom_histogram(binwidth = 1, boundary = 0,
colour = "black", fill = "grey70") +
labs(
title = "Distribution of whistling pitch ranges",
x = "Pitch range (semitones)",
y = "Number of participants"
) +
theme_bw()
